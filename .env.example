# ==========================================
# Nachos Marketplace Bot & Web Dashboard
# Environment Configuration
# ==========================================

# Discord Bot Token (REQUIRED)
# Get from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN="YOUR_BOT_TOKEN_HERE"

# Guild / Server ID (Optional: comma-separated list of server IDs)
# If left unset, uses defaults configured in bot.js
# GUILD_IDS="1497496326517031034,1472127319140339722,1096444793841791030"

# Optional Custom Channel / Role IDs
# TICKET_CATEGORY_ID="1545423374258405456"
# STAFF_ROLE_ID="1500459667535564911"
# RESELLER_ROLE_ID="1497496326517031040"
# STAFF_USER_ID="1421835488808931441"
# LOGS_CHANNEL_ID="1545439297942065272"

# Server Port (Render sets this automatically)
# PORT=10000

# Environment Mode
NODE_ENV="production"
